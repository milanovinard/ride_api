              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const times = pm.response.json().results.map(r => new Date(r.pickup_time).getTime());",
                  "pm.test('descending by pickup_time', () => {",
                  "  for (let i = 1; i < times.length; i++) pm.expect(times[i]).to.be.at.most(times[i - 1]);",
                  "});"
