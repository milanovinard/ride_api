          "name": "Sort by distance (nearest first)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('distance_km is present when sorting by distance', () => {",
                  "  pm.expect(json.results[0]).to.have.property('distance_km');",
                  "});",
                  "pm.test('ascending by distance_km', () => {",
                  "  const d = json.results.map(r => r.distance_km);",
                  "  for (let i = 1; i < d.length; i++) pm.expect(d[i]).to.be.at.least(d[i - 1]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/rides/?ordering=distance&latitude=40.7128&longitude=-74.0060",
              "host": ["{{base_url}}"],
              "path": ["api", "rides", ""],
              "query": [
                { "key": "ordering", "value": "distance" },
                { "key": "latitude", "value": "40.7128" },
                { "key": "longitude", "value": "-74.0060" }
              ]
            }
          }
        },
