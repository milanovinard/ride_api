    {
      "name": "Ride List API",
      "item": [
        {
          "name": "List rides (default)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('paginated envelope', () => pm.expect(json).to.include.keys('count', 'next', 'previous', 'results'));",
                  "pm.test('each ride has nested rider/driver + todays_ride_events', () => {",
                  "  json.results.forEach(r => {",
                  "    pm.expect(r).to.have.property('rider');",
                  "    pm.expect(r).to.have.property('todays_ride_events');",
                  "  });",
                  "});",
                  "pm.test('todays_ride_events only holds events from the last 24h', () => {",
                  "  const now = Date.now();",
                  "  json.results.forEach(r => r.todays_ride_events.forEach(e => {",
                  "    pm.expect(now - new Date(e.created_at).getTime()).to.be.below(24 * 3600 * 1000 + 60000);",
                  "  }));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/rides/",
              "host": ["{{base_url}}"],
              "path": ["api", "rides", ""]
