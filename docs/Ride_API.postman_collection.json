{
  "info": {
    "name": "Ride API",
    "_postman_id": "b1d7e9a0-0000-4a00-8a00-r1de4p1c0110",
    "description": "Functional test collection for the Ride API (Django REST Framework).\n\nAuth model: any active user can POST /api/auth/login/ and receive tokens, but every business endpoint additionally requires role == 'admin' (otherwise 403).\n\nUsage:\n1. Start the API on {{base_url}} and create an admin user (see TESTING.md, Step 0).\n2. Set the collection variables admin_username / admin_password.\n3. Run the collection top-to-bottom (Run collection), or fire requests in order.\n\nEvery request has pm.test assertions, so 'Run collection' is a full functional pass/fail of the API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "admin_username", "value": "admin" },
    { "key": "admin_password", "value": "admin12345" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "rider_id", "value": "" },
    { "key": "driver_id", "value": "" },
    { "key": "rider_username", "value": "" },
    { "key": "rider_password", "value": "riderpass123" },
    { "key": "ride_id", "value": "" },
    { "key": "far_ride_id", "value": "" },
    { "key": "ride_event_id", "value": "" },
    { "key": "rider_access_token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('returns user + access + refresh', () => {",
                  "  pm.expect(json).to.have.property('access');",
                  "  pm.expect(json).to.have.property('refresh');",
                  "  pm.expect(json).to.have.property('user');",
                  "});",
                  "pm.test('logged-in user is an admin', () => pm.expect(json.user.role).to.eql('admin'));",
                  "pm.test('password is not in the user payload', () => pm.expect(json.user).to.not.have.property('password'));",
                  "pm.collectionVariables.set('access_token', json.access);",
                  "pm.collectionVariables.set('refresh_token', json.refresh);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/auth/login/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login", ""]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{admin_username}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            }
          }
        },
        {
          "name": "Me (current user)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('is the admin we logged in as', () => pm.expect(pm.response.json().username).to.eql(pm.collectionVariables.get('admin_username')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/me/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "me", ""]
            }
          }
        },
        {
          "name": "Refresh token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('returns a new access token', () => pm.expect(json).to.have.property('access'));",
                  "pm.collectionVariables.set('access_token', json.access);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/auth/refresh/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "refresh", ""]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            }
          }
        }
      ]
