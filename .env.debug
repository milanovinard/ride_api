# Environment for LOCAL DEBUGGING (VS Code reads this via .vscode/settings.json
# and the launch configs' "envFile"). Safe to commit - contains no real secrets.
#
# Postgres itself still runs in Docker, but docker-compose.yml publishes it on
# localhost:5432, so the debugger (running on the host) can reach it directly:
#
#     docker compose up -d db
#
# django-environ does not overwrite variables already in the environment, so the
# values below win over any .env file that still points at the "db" host.

DEBUG=True
SECRET_KEY=dev-debug-insecure-key-do-not-use-in-prod
ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=ride_api
POSTGRES_USER=ride_api
POSTGRES_PASSWORD=ride_api
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
